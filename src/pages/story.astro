---
import Base from "../layouts/Base.astro";
import Relief from "../components/Relief.astro";
import { chapters, closing, values, valuesTitle } from "../data/story";
import { pages } from "../data/pages";
import { profilePageJsonLd } from "../lib/structured-data";

const at = closing.text.indexOf(closing.ask);

// The hero's chiseled groove: a V-cut that tapers to a point at each end, with slightly uneven, hand-cut edges.
const groove = (() => {
  let seed = 11;
  const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647) * 2 - 1;
  const [x0, x1, mid, depth] = [4, 316, 12, 4.4];
  const xs = Array.from({ length: 27 }, (_, i) => x0 + ((x1 - x0) * i) / 26);
  const half = (x: number) => depth * Math.min(1, (x - x0) / 22, (x1 - x) / 22) ** 0.7;
  const edge = (sign: number) => xs.map((x) => [x, mid + sign * (half(x) + (half(x) ? rand() * 0.3 : 0))]);
  const floor = xs.map((x) => [x, mid + 0.3 + rand() * 0.12]);
  const d = (pts: number[][]) => pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(2)}`).join(" ");
  const wall = (top: number[][]) => `${d(top)} ${d([...floor].reverse()).replace("M", "L")} Z`;
  const upper = edge(-1);
  const lower = edge(1);
  return { upper: wall(upper), lower: wall(lower), lip: d(lower.map(([x, y]) => [x, y + 0.8])), floor: d(floor) };
})();
---

<Base title={pages.story.title} description={pages.story.description} jsonLd={profilePageJsonLd()}>
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <filter id="ink-rough" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="7" />
      <feDisplacementMap in="SourceGraphic" scale="2.6" />
    </filter>
    <filter id="ink-bleed" x="-30%" y="-30%" width="160%" height="160%">
      <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="2" />
      <feDisplacementMap in="SourceGraphic" scale="10" />
      <feGaussianBlur stdDeviation="2.4" />
    </filter>
    <linearGradient id="wash-down" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.2" />
      <stop offset="1" stop-color="currentColor" stop-opacity="0" />
    </linearGradient>
  </svg>

  <section class="story-hero mx-auto flex max-w-6xl flex-col justify-center px-6 pt-12 pb-16 md:pt-20">
    <p class="label text-muted" data-reveal data-md-skip>story</p>
    <h1 class="mt-4 font-display text-5xl leading-[1.02] tracking-tight sm:text-7xl" data-reveal style="--i:1">
      {pages.story.headline}<br />
      <span class="text-muted">{pages.story.headlineAside}</span>
    </h1>
    <div class="chisel mt-5 w-56 sm:w-72" data-chisel aria-hidden="true">
      <svg viewBox="0 0 320 24" class="chisel-cut">
        <defs>
          <linearGradient id="chisel-shade" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" class="shade-top" />
            <stop offset="1" class="shade-deep" />
          </linearGradient>
          <linearGradient id="chisel-lit" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" class="lit-deep" />
            <stop offset="1" class="lit-top" />
          </linearGradient>
        </defs>
        <path class="lip" d={groove.lip} />
        <path class="wall-shade" d={groove.upper} />
        <path class="wall-lit" d={groove.lower} />
        <path class="floor" d={groove.floor} />
      </svg>
    </div>
    <p class="label mt-16 text-muted" aria-hidden="true">scroll ↓</p>
  </section>

  <div class="mx-auto max-w-6xl px-6 pb-16">
    {
      chapters.map((c, i) => (
        <section class:list={["chapter", { flip: i % 2 === 1 }]} data-chapter aria-labelledby={`chapter-${i}`}>
          <div class="chapter-pin">
            <div class="chapter-art">
              <Relief scene={c.scene} class="w-full" />
            </div>
            <div class="chapter-text">
              <hgroup>
                <p class="label text-muted" data-line>
                  {String(i + 1).padStart(2, "0")} · {c.place}
                </p>
                <h2 id={`chapter-${i}`} class="mt-3 font-display text-4xl leading-tight sm:text-5xl" data-line>
                  {c.title}
                </h2>
              </hgroup>
              {c.paragraphs.map((p) => (
                <p class="story-p mt-6" data-line>
                  {p}
                </p>
              ))}
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <section class="mx-auto max-w-3xl px-6 pb-32 text-center">
    <h2 class="font-display text-3xl sm:text-4xl" data-reveal>{valuesTitle}</h2>
    <ul class="mt-6 flex flex-col gap-2 font-display text-xl italic text-ink/80 sm:text-2xl" data-reveal style="--i:1">
      {values.map((v) => <li>{v}</li>)}
    </ul>
    <p class="mt-12 text-lg text-ink/80" data-reveal style="--i:2">
      {closing.text.slice(0, at)}
      <a class="link" href="/contact">{closing.ask}</a>
      {closing.text.slice(at + closing.ask.length)}
    </p>
  </section>
</Base>

<style>
  @media (min-width: 768px) {
    .story-hero {
      min-height: min(78vh, 44rem);
    }
  }
  .chapter {
    padding-block: 3.5rem;
  }
  .chapter-pin {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .chapter-art {
    position: relative;
    width: min(100%, 24rem);
    margin-inline: auto;
  }
  /* Sticky boxes are their own stacking contexts, so the relief's blend has to happen at the outermost one to reach the page. */
  .chapter-pin {
    mix-blend-mode: multiply;
  }
  :global([data-theme="dark"]) .chapter-pin {
    mix-blend-mode: screen;
  }
  .story-p {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.6;
    color: color-mix(in oklab, var(--ink) 86%, transparent);
  }
  @media (min-width: 768px) {
    .chapter {
      min-height: 125vh;
      padding-block: 0;
    }
    .chapter-pin {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
    .chapter-art {
      position: sticky;
      top: 14vh;
      width: min(100%, 32rem);
    }
    .chapter-text {
      padding-block: 26vh 30vh;
    }
    .flip .chapter-art {
      order: 2;
    }
  }
  /* Desktop: each chapter pins its sculpture and text side by side for a beat of scrolling before moving on. */
  @media (min-width: 768px) and (min-height: 700px) {
    .chapter {
      height: 170vh;
    }
    .chapter-pin {
      position: sticky;
      top: 0;
      height: 100vh;
      align-items: center;
    }
    .chapter-art {
      position: relative;
      top: auto;
    }
    .chapter-text {
      padding-block: 0;
    }
  }
  /* An incised V-groove lit from above: the upper wall falls in shadow, the lower wall catches the light. */
  .chisel {
    position: relative;
    --cut: 100%;
  }
  :global(.js) .chisel {
    --cut: 0%;
  }
  .chisel-cut {
    display: block;
    width: 100%;
    overflow: visible;
    clip-path: inset(-6px calc(100% - var(--cut)) -6px 0);
  }
  .chisel-cut {
    --shade-top: color-mix(in oklab, var(--ink) 44%, var(--paper));
    --shade-deep: color-mix(in oklab, var(--ink) 72%, var(--paper));
    --lit-deep: color-mix(in oklab, var(--ink) 30%, var(--paper));
    --lit-top: color-mix(in oklab, var(--ink) 6%, var(--paper));
    --lip: #fff;
  }
  :global([data-theme="dark"]) .chisel-cut {
    --shade-top: color-mix(in oklab, #000 55%, var(--paper));
    --shade-deep: #000;
    --lit-deep: color-mix(in oklab, var(--ink) 16%, var(--paper));
    --lit-top: color-mix(in oklab, var(--ink) 38%, var(--paper));
    --lip: color-mix(in oklab, var(--ink) 30%, var(--paper));
  }
  .shade-top {
    stop-color: var(--shade-top);
  }
  .shade-deep {
    stop-color: var(--shade-deep);
  }
  .lit-deep {
    stop-color: var(--lit-deep);
  }
  .lit-top {
    stop-color: var(--lit-top);
  }
  .chisel-cut .wall-shade {
    fill: url(#chisel-shade);
  }
  .chisel-cut .wall-lit {
    fill: url(#chisel-lit);
  }
  .chisel-cut .floor {
    fill: none;
    stroke: var(--shade-deep);
    stroke-width: 0.45;
  }
  .chisel-cut .lip {
    fill: none;
    stroke: var(--lip);
    stroke-width: 1.1;
  }
  /* Stone chips knocked loose at the cutting edge on each strike. */
  .chisel :global(.chip) {
    position: absolute;
    pointer-events: none;
    background: color-mix(in oklab, var(--ink) 34%, var(--paper));
    clip-path: polygon(10% 0, 100% 30%, 70% 100%, 0 70%);
  }
  .chisel :global(.dust) {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    background: color-mix(in oklab, var(--ink) 18%, var(--paper));
    filter: blur(2px);
  }
  :global(.js) .chapter :global(.ink-s) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(.js) .chapter :global(.ink-w),
  :global(.js) .chapter [data-line] {
    opacity: 0;
  }
  @media print {
    :global(.js) .chisel {
      --cut: 100%;
    }
    .chapter :global(.ink-s) {
      stroke-dashoffset: 0 !important;
    }
    .chapter :global(.ink-w),
    .chapter [data-line] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .chisel {
      --cut: 100%;
    }
    :global(.js) .chapter :global(.ink-s) {
      stroke-dashoffset: 0;
    }
    :global(.js) .chapter :global(.ink-w),
    :global(.js) .chapter [data-line] {
      opacity: 1;
    }
  }
</style>

<script>
  import { mountReliefs } from "../lib/reliefGL";
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const ease = (t: number) => t * t * (3 - 2 * t);

  /** Cuts the hero groove in left to right, one chisel strike at a time, throwing chips off the cutting edge. */
  function chisel() {
    const el = document.querySelector<HTMLElement>("[data-chisel]");
    if (!el || el.dataset.cut) return;
    el.dataset.cut = "";
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const svg = el.querySelector("svg")!;
    const timers: number[] = [];
    let cut = 0;
    const strike = () => {
      const from = cut;
      cut = Math.min(100, cut + 4.5 + Math.random() * 4.5);
      // A strike drives the edge forward fast, then it settles; the pause between strikes is uneven, like a hand.
      const to = cut;
      const clip = (c: number) => `inset(-6px ${100 - c}% -6px 0)`;
      svg
        .animate([{ clipPath: clip(from) }, { clipPath: clip(to) }], {
          duration: 70,
          easing: "cubic-bezier(0.2, 0.9, 0.3, 1)",
          fill: "forwards",
        })
        .finished.then((a) => {
          el.style.setProperty("--cut", `${to}%`);
          a.cancel();
        }, () => {});
      spray(el, (cut / 100) * el.offsetWidth);
      if (cut < 100) timers.push(window.setTimeout(strike, 110 + Math.random() * 70));
    };
    timers.push(window.setTimeout(strike, 450));
    document.addEventListener("astro:before-swap", () => timers.forEach(clearTimeout), { once: true });
  }

  function spray(el: HTMLElement, x: number) {
    const y = el.offsetHeight / 2;
    const bits = 2 + Math.floor(Math.random() * 3);
    for (let i = 0; i < bits + 2; i++) {
      const dust = i >= bits;
      const bit = document.createElement("span");
      bit.className = dust ? "dust" : "chip";
      const size = dust ? 5 + Math.random() * 6 : 1.5 + Math.random() * 2.5;
      Object.assign(bit.style, { width: `${size}px`, height: `${size}px`, left: `${x - size / 2}px`, top: `${y - size / 2}px` });
      el.append(bit);
      // Chips fly up and forward off the edge, then fall; dust drifts and fades where it was struck.
      const dx = dust ? 4 + Math.random() * 8 : 6 + Math.random() * 22;
      const up = dust ? 3 + Math.random() * 5 : 6 + Math.random() * 12;
      const fall = dust ? -2 : 10 + Math.random() * 18;
      const spin = (Math.random() - 0.5) * 540;
      bit
        .animate(
          [
            { transform: "translate(0, 0) rotate(0deg)", opacity: dust ? 0.7 : 1 },
            { transform: `translate(${dx * 0.55}px, ${-up}px) rotate(${spin * 0.5}deg)`, opacity: dust ? 0.4 : 1, offset: 0.35 },
            { transform: `translate(${dx}px, ${fall}px) rotate(${spin}deg)`, opacity: 0 },
          ],
          { duration: dust ? 700 + Math.random() * 300 : 450 + Math.random() * 300, easing: "cubic-bezier(0.3, 0.6, 0.6, 1)" },
        )
        .finished.then(() => bit.remove(), () => bit.remove());
    }
  }

  function initStory() {
    chisel();
    const unmount = mountReliefs(document.querySelector("main") ?? document.body);
    if (unmount) document.addEventListener("astro:before-swap", unmount, { once: true });
    const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];
    if (!chapters.length || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const items = chapters.map((el) => ({
      el,
      strokes: [...el.querySelectorAll<SVGElement>(".ink-s")],
      washes: [...el.querySelectorAll<SVGElement>(".ink-w")],
      lines: [...el.querySelectorAll<HTMLElement>("[data-line]")],
    }));

    // Each chapter's progress runs 0 → 1 as it scrolls from the bottom of the window to the
    // middle; strokes brush in one after another, then the washes soak in. Scrolling up reverses it.
    const update = () => {
      raf = 0;
      const vh = innerHeight;
      for (const { el, strokes, washes, lines } of items) {
        const r = el.getBoundingClientRect();
        if (r.bottom < -vh || r.top > vh * 2) continue;
        const p = clamp((vh * 0.92 - r.top) / (Math.min(r.height, vh * 1.1) * 0.75));
        strokes.forEach((s, i) => {
          const start = 0.04 + (i / strokes.length) * 0.5;
          s.style.strokeDashoffset = String(1 - ease(clamp((p - start) / 0.22)));
        });
        const w = String(ease(clamp((p - 0.45) / 0.3)));
        washes.forEach((s) => (s.style.opacity = w));
        lines.forEach((l, i) => {
          const t = ease(clamp((p - 0.08 - i * 0.12) / 0.18));
          l.style.opacity = String(t);
          l.style.transform = `translateY(${(1 - t) * 18}px)`;
        });
      }
    };
    let raf = 0;
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    update();
    document.addEventListener(
      "astro:before-swap",
      () => {
        removeEventListener("scroll", schedule);
        removeEventListener("resize", schedule);
        cancelAnimationFrame(raf);
      },
      { once: true },
    );
  }
  document.addEventListener("astro:page-load", initStory);
</script>
