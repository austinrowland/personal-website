---
import Base from "../layouts/Base.astro";
import Relief from "../components/Relief.astro";
import { chapters, closing, values, valuesTitle } from "../data/story";
import { pages } from "../data/pages";
import { profilePageJsonLd } from "../lib/structured-data";

const at = closing.text.indexOf(closing.ask);
---

<Base title={pages.story.title} description={pages.story.description} jsonLd={profilePageJsonLd()}>
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <filter id="ink-rough" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="7" />
      <feDisplacementMap in="SourceGraphic" scale="2.6" />
    </filter>
    <filter id="ink-bleed" x="-30%" y="-30%" width="160%" height="160%">
      <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="2" />
      <feDisplacementMap in="SourceGraphic" scale="10" />
      <feGaussianBlur stdDeviation="2.4" />
    </filter>
    <linearGradient id="wash-down" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.2" />
      <stop offset="1" stop-color="currentColor" stop-opacity="0" />
    </linearGradient>
  </svg>

  <section class="story-hero mx-auto flex max-w-6xl flex-col justify-center px-6 pt-12 pb-16 md:pt-20">
    <p class="label text-muted" data-reveal data-md-skip>story</p>
    <h1 class="mt-4 font-display text-5xl leading-[1.02] tracking-tight sm:text-7xl" data-reveal style="--i:1">
      {pages.story.headline}<br />
      <span class="text-muted">{pages.story.headlineAside}</span>
    </h1>
    <svg viewBox="0 0 320 24" class="hero-stroke mt-5 w-56 sm:w-72" aria-hidden="true">
      <path d="M6 15 C70 6 140 20 210 11 S300 8 314 13" pathLength="1" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round" filter="url(#ink-rough)" />
    </svg>
    <p class="label mt-16 text-muted" aria-hidden="true">scroll ↓</p>
  </section>

  <div class="mx-auto max-w-6xl px-6 pb-16">
    {
      chapters.map((c, i) => (
        <section class:list={["chapter", { flip: i % 2 === 1 }]} data-chapter aria-labelledby={`chapter-${i}`}>
          <div class="chapter-art">
            <Relief scene={c.scene} class="w-full" />
          </div>
          <div class="chapter-text">
            <hgroup>
              <p class="label text-muted" data-line>
                {String(i + 1).padStart(2, "0")} · {c.place}
              </p>
              <h2 id={`chapter-${i}`} class="mt-3 font-display text-4xl leading-tight sm:text-5xl" data-line>
                {c.title}
              </h2>
            </hgroup>
            {c.paragraphs.map((p) => (
              <p class="story-p mt-6" data-line>
                {p}
              </p>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <section class="mx-auto max-w-3xl px-6 pb-32 text-center">
    <h2 class="font-display text-3xl sm:text-4xl" data-reveal>{valuesTitle}</h2>
    <ul class="mt-6 flex flex-col gap-2 font-display text-xl italic text-ink/80 sm:text-2xl" data-reveal style="--i:1">
      {values.map((v) => <li>{v}</li>)}
    </ul>
    <p class="mt-12 text-lg text-ink/80" data-reveal style="--i:2">
      {closing.text.slice(0, at)}
      <a class="link" href="/contact">{closing.ask}</a>
      {closing.text.slice(at + closing.ask.length)}
    </p>
  </section>
</Base>

<style>
  @media (min-width: 768px) {
    .story-hero {
      min-height: min(78vh, 44rem);
    }
  }
  .chapter {
    display: grid;
    gap: 2rem;
    align-items: start;
    padding-block: 3.5rem;
  }
  .chapter-art {
    position: relative;
    width: min(100%, 24rem);
    margin-inline: auto;
  }
  /* Sticky art is its own stacking context, so the relief's blend has to happen here to reach the page. */
  .chapter-art {
    mix-blend-mode: multiply;
  }
  :global([data-theme="dark"]) .chapter-art {
    mix-blend-mode: screen;
  }
  .story-p {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.6;
    color: color-mix(in oklab, var(--ink) 86%, transparent);
  }
  @media (min-width: 768px) {
    .chapter {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      min-height: 125vh;
      padding-block: 0;
    }
    .chapter-art {
      position: sticky;
      top: 14vh;
      width: min(100%, 32rem);
    }
    .chapter-text {
      padding-block: 26vh 30vh;
    }
    .flip .chapter-art {
      order: 2;
    }
  }
  .hero-stroke path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: brush 1.2s cubic-bezier(0.6, 0.1, 0.2, 1) 0.5s forwards;
  }
  @keyframes brush {
    to {
      stroke-dashoffset: 0;
    }
  }
  :global(.js) .chapter :global(.ink-s) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(.js) .chapter :global(.ink-w),
  :global(.js) .chapter [data-line] {
    opacity: 0;
  }
  @media print {
    .chapter :global(.ink-s) {
      stroke-dashoffset: 0 !important;
    }
    .chapter :global(.ink-w),
    .chapter [data-line] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-stroke path {
      animation: none;
      stroke-dashoffset: 0;
    }
    :global(.js) .chapter :global(.ink-s) {
      stroke-dashoffset: 0;
    }
    :global(.js) .chapter :global(.ink-w),
    :global(.js) .chapter [data-line] {
      opacity: 1;
    }
  }
</style>

<script>
  import { mountReliefs } from "../lib/reliefGL";
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const ease = (t: number) => t * t * (3 - 2 * t);

  function initStory() {
    const unmount = mountReliefs(document.querySelector("main") ?? document.body);
    if (unmount) document.addEventListener("astro:before-swap", unmount, { once: true });
    const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];
    if (!chapters.length || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const items = chapters.map((el) => ({
      el,
      strokes: [...el.querySelectorAll<SVGElement>(".ink-s")],
      washes: [...el.querySelectorAll<SVGElement>(".ink-w")],
      lines: [...el.querySelectorAll<HTMLElement>("[data-line]")],
    }));

    // Each chapter's progress runs 0 → 1 as it scrolls from the bottom of the window to the
    // middle; strokes brush in one after another, then the washes soak in. Scrolling up reverses it.
    const update = () => {
      raf = 0;
      const vh = innerHeight;
      for (const { el, strokes, washes, lines } of items) {
        const r = el.getBoundingClientRect();
        if (r.bottom < -vh || r.top > vh * 2) continue;
        const p = clamp((vh * 0.92 - r.top) / (Math.min(r.height, vh * 1.1) * 0.75));
        strokes.forEach((s, i) => {
          const start = 0.04 + (i / strokes.length) * 0.5;
          s.style.strokeDashoffset = String(1 - ease(clamp((p - start) / 0.22)));
        });
        const w = String(ease(clamp((p - 0.45) / 0.3)));
        washes.forEach((s) => (s.style.opacity = w));
        lines.forEach((l, i) => {
          const t = ease(clamp((p - 0.08 - i * 0.12) / 0.18));
          l.style.opacity = String(t);
          l.style.transform = `translateY(${(1 - t) * 18}px)`;
        });
      }
    };
    let raf = 0;
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    update();
    document.addEventListener(
      "astro:before-swap",
      () => {
        removeEventListener("scroll", schedule);
        removeEventListener("resize", schedule);
        cancelAnimationFrame(raf);
      },
      { once: true },
    );
  }
  document.addEventListener("astro:page-load", initStory);
</script>
