---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import { site } from "../data/site";
---

<Base title="Contact" description="Get in touch with Austin Rowland or book a 30-minute call.">
  <PageIntro eyebrow="contact" title="Building with agents? Let's talk.">
    <div class="mt-4 flex flex-wrap items-center gap-3" data-reveal style="--i:2">
      <a href={`mailto:${site.email}`} class="rounded-full border border-line px-4 py-2 text-ink transition-colors hover:border-accent">
        {site.email}
      </a>
      <button
        type="button"
        data-copy={site.email}
        class="label rounded-full border border-line px-3 py-2 text-muted transition-colors hover:text-ink"
      >
        copy
      </button>
    </div>
  </PageIntro>

  <section class="mx-auto max-w-4xl px-6 pb-28">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="font-display text-3xl">Book a call</h2>
      <a href={site.calUrl} target="_blank" rel="noopener noreferrer" class="label link text-muted">
        open in cal.com ↗
      </a>
    </div>
    <div class="print overflow-hidden rounded-sm" data-reveal>
      <iframe
        src={site.calUrl}
        title="Book a 30-minute call with Austin Rowland"
        loading="lazy"
        class="h-[720px] w-full border-0 bg-paper"
      ></iframe>
    </div>
  </section>
</Base>

<script>
  function initCopy() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
          btn.textContent = "copied";
          setTimeout(() => (btn.textContent = "copy"), 1600);
        } catch {
          btn.textContent = "press ⌘c";
        }
      });
    });
  }
  document.addEventListener("astro:page-load", initCopy);
</script>
