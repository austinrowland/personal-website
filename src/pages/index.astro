---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import FilmStrips from "../components/FilmStrips.astro";
import headshot from "../assets/headshot.jpg";
import { homeJsonLd } from "../lib/structured-data";
import { homeIntro, homeTagline } from "../data/home";
import { pages } from "../data/pages";

const greeting = pages.home.headline;
const chars = [...greeting];
const typeDone = 700 + chars.length * 55;
---

<Base jsonLd={homeJsonLd()}>
  <section
    class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-12 pb-20 md:grid-cols-[1.1fr_1fr] md:pt-20"
  >
    <div class="flex flex-col gap-8">
      <h1
        aria-label={greeting}
        class="flex items-baseline gap-3 font-display text-5xl leading-[1.02] tracking-tight sm:text-7xl"
      >
        <span aria-hidden="true" class="caret text-[0.45em] text-accent">▶</span>
        <span aria-hidden="true">
          {chars.map((c, i) => <span class="type-char" style={`--d:${i}`}>{c}</span>)}
        </span>
      </h1>
      <div
        class="fade-after-type flex max-w-xl flex-col gap-4 text-lg lowercase leading-relaxed text-ink/85"
        style={`--after:${typeDone + 150}ms`}
      >
        {
          homeIntro.map((para) => (
            <p>
              {para.map((s) =>
                typeof s === "string" ? (
                  s
                ) : s.href.startsWith("/") ? (
                  <a class="link" href={s.href}>{s.text}</a>
                ) : (
                  <a class="link" href={s.href} target="_blank" rel="noopener noreferrer">{s.text}</a>
                ),
              )}
            </p>
          ))
        }
      </div>
    </div>
    <div
      class="fade-after-type md:rotate-[1.2deg]"
      style={`--after:${typeDone + 450}ms`}
    >
      <Photo
        src={headshot}
        alt="Austin Rowland smiling on the coast in a cream sweatshirt and sunglasses"
        caption="austin rowland · san francisco"
        loading="eager"
        sizes="(min-width: 768px) 45vw, 100vw"
      />
    </div>
  </section>

  <section class="px-6 pb-24">
    <FilmStrips />
  </section>

  <section class="px-6 pb-28 text-center" data-reveal>
    <p class="mx-auto max-w-3xl font-display text-3xl leading-tight sm:text-5xl">
      {homeTagline[0]}
      <span class="block text-muted">{homeTagline[1]}</span>
    </p>
    <a href="/contact" class="label link mt-10 inline-block text-muted">
      let's talk →
    </a>
  </section>
</Base>
