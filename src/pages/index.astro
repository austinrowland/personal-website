---
import Base from "../layouts/Base.astro";
---

<Base title="Austin Rowland">
  <main
    class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-4 px-6"
  >
    <p class="font-mono text-xs uppercase tracking-widest text-muted">
      Field notes
    </p>
    <h1 class="font-display text-5xl font-medium tracking-tight">
      Austin Rowland
    </h1>
    <p class="text-lg leading-relaxed text-muted">
      Building agents and agent infrastructure at Postman. New site in
      progress.
    </p>
  </main>
</Base>
