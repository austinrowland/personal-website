---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import headshot from "../assets/headshot.jpg";
import { homeJsonLd } from "../lib/structured-data";
import { homeIntro } from "../data/home";
import { pages } from "../data/pages";

const greeting = pages.home.headline;
const chars = [...greeting];
const typeDone = 700 + chars.length * 55;
---

<Base jsonLd={homeJsonLd()}>
  <section
    class="mx-auto grid min-h-[calc(100svh-10rem)] max-w-6xl items-end gap-12 px-6 pt-12 pb-24 md:grid-cols-[1.25fr_1fr] md:items-center"
  >
    <div class="flex flex-col gap-8">
      <h1
        aria-label={greeting}
        class="flex items-baseline gap-3 font-display text-5xl leading-[1.02] tracking-tight sm:text-7xl"
      >
        <span aria-hidden="true" class="caret text-[0.45em] text-accent">▶</span>
        <span aria-hidden="true">
          {chars.map((c, i) => <span class="type-char" style={`--d:${i}`}>{c}</span>)}
        </span>
      </h1>
      <div
        class="fade-after-type flex max-w-xl flex-col gap-3 text-lg lowercase leading-relaxed text-ink/85"
        style={`--after:${typeDone + 150}ms`}
      >
        {
          homeIntro.map((para) => (
            <p>
              {para.map((s) =>
                typeof s === "string" ? (
                  s
                ) : s.href.startsWith("/") ? (
                  <a class="link" href={s.href}>{s.text}</a>
                ) : (
                  <a class="link" href={s.href} target="_blank" rel="noopener noreferrer">{s.text}</a>
                ),
              )}
            </p>
          ))
        }
      </div>
    </div>
    <div
      class="fade-after-type mx-auto w-full max-w-sm md:rotate-[1.2deg]"
      style={`--after:${typeDone + 450}ms`}
    >
      <Photo
        src={headshot}
        alt="Austin Rowland smiling on the coast in a cream sweatshirt and sunglasses"
        caption="austin rowland · san francisco"
        loading="eager"
        sizes="(min-width: 768px) 24rem, 100vw"
      />
    </div>
  </section>

</Base>
