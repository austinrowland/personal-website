---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import headshot from "../assets/headshot.jpg";
import { photoAlt } from "../data/photos";
import { aboutIntro, chapters, values } from "../data/about";
import { pages } from "../data/pages";
import { profilePageJsonLd } from "../lib/structured-data";

const stack = [
  { name: "georgia-tech-graduation", alt: "At Georgia Tech commencement" },
  { name: "ultramarathon", alt: "Running an ultramarathon" },
  { name: "tedx-gt", alt: "On stage at TEDxGeorgiaTech" },
];

---

<Base title={pages.about.title} description={pages.about.description} jsonLd={profilePageJsonLd()}>
  <section
    class="mx-auto grid max-w-6xl items-center gap-16 px-6 pt-12 pb-24 md:grid-cols-2 md:pt-20"
  >
    <div class="flex flex-col gap-6">
      <p class="label text-muted" data-reveal>about</p>
      <h1
        class="font-display text-5xl leading-[1.05] tracking-tight sm:text-6xl"
        data-reveal
        style="--i:1"
      >
        A little peek <span class="text-muted">into my life.</span>
      </h1>
      <p class="max-w-md text-lg leading-relaxed text-ink/80" data-reveal style="--i:2">
        {aboutIntro}
      </p>
    </div>
    <div class="fan relative mx-auto aspect-[4/3] w-full max-w-md" data-reveal>
      {
        stack.map((p, i) => (
          <div class="fan-card absolute inset-0" style={`--n:${i}`}>
            <Photo alt={p.alt} name={p.name} class="aspect-[4/3]" />
          </div>
        ))
      }
      <div class="fan-card absolute inset-0" style="--n:3">
        <Photo
          src={headshot}
          alt="Austin Rowland on the coast"
          class="aspect-[4/3]"
          sizes="(min-width: 768px) 28rem, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <ol class="flex flex-col">
      {
        chapters.map((c, i) => (
          <li class="grid gap-6 border-t border-line py-14 md:grid-cols-[14rem_1fr_1fr] md:gap-10">
            <p class="label text-muted md:sticky md:top-8 md:self-start">
              {String(i + 1).padStart(2, "0")} / {c.label}
            </p>
            <div class="flex flex-col gap-4" data-reveal>
              <h2 class="font-display text-3xl leading-tight sm:text-4xl">{c.title}</h2>
              <p class="leading-relaxed text-ink/80">{c.body}</p>
            </div>
            <div data-reveal style="--i:1" class:list={[i % 2 ? "md:rotate-[-1deg]" : "md:rotate-[1deg]"]}>
              <Photo alt={photoAlt(c.photo, c.title)} name={c.photo} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-t border-line px-6 py-24">
    <ul class="mx-auto flex max-w-4xl flex-col gap-4 text-center">
      {
        values.map((v, i) => (
          <li
            class:list={[
              "font-display text-3xl leading-tight sm:text-4xl",
              i > 0 && "text-muted",
            ]}
            data-reveal
            style={`--i:${i}`}
          >
            {v}
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .fan-card {
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .fan.is-visible .fan-card {
    transform: translate(calc((var(--n) - 1.5) * 9%), calc((var(--n) - 1.5) * -2%))
      rotate(calc((var(--n) - 1.5) * 4deg));
  }
  @media (prefers-reduced-motion: reduce) {
    .fan .fan-card {
      transform: translate(calc((var(--n) - 1.5) * 9%), calc((var(--n) - 1.5) * -2%))
        rotate(calc((var(--n) - 1.5) * 4deg));
    }
  }
</style>
