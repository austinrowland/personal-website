---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import Polaroid from "../components/Polaroid.astro";
import { gallery, galleryIntro, tilts } from "../data/photos";
import { pages } from "../data/pages";
---

<Base title={pages.photos.title} description={pages.photos.description}>
  <PageIntro eyebrow="photos" title={pages.photos.headline}>
    <p class="max-w-2xl text-lg leading-relaxed text-ink/80" data-reveal style="--i:2">
      {galleryIntro}
    </p>
  </PageIntro>

  <section class="mx-auto max-w-6xl px-6 pb-28">
    <ul class="grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {
        gallery.map((p, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <Polaroid photo={p} tilt={tilts[i % tilts.length]} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  function initPolaroids() {
    document.querySelectorAll<HTMLElement>("[data-polaroid]").forEach((card) => {
      const button = card.querySelector<HTMLButtonElement>(".flip");
      const back = card.querySelector<HTMLElement>(".back");
      if (!button || !back || card.dataset.bound) return;
      card.dataset.bound = "true";
      button.addEventListener("click", () => {
        const flipped = button.getAttribute("aria-pressed") !== "true";
        button.setAttribute("aria-pressed", String(flipped));
        back.setAttribute("aria-hidden", String(!flipped));
      });
    });
  }
  document.addEventListener("astro:page-load", initPolaroids);
</script>
