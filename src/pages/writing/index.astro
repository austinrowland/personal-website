---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { pages } from "../../data/pages";
import PageIntro from "../../components/PageIntro.astro";

const posts = (await getCollection("writing")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<Base title={pages.writing.title} description={pages.writing.description}>
  <PageIntro eyebrow="writing" title={pages.writing.headline} />

  <section class="mx-auto max-w-6xl px-6 pb-28">
    <ul class="border-t border-line">
      {
        posts.map((post, i) => (
          <li class="border-b border-line" data-reveal style={`--i:${i}`}>
            <a
              href={`/writing/${post.id}`}
              class="group flex flex-col gap-2 py-7 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
            >
              <span class="font-display text-2xl leading-tight transition-colors group-hover:text-accent sm:text-3xl">
                {post.data.title}
              </span>
              <time class="label shrink-0 text-muted" datetime={post.data.date.toISOString().slice(0, 10)}>
                {fmt.format(post.data.date)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
