---
import { nav, socials } from "../data/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  class="mx-auto flex w-full max-w-6xl items-center justify-between gap-3 px-4 py-5 sm:px-6"
>
  <a href="/" class="flex items-center gap-2.5" aria-label="Austin Rowland, home">
    <Logo class="size-8" />
    <span class="hidden text-sm font-medium text-ink/80 md:inline">Austin Rowland</span>
  </a>
  <div class="flex min-w-0 items-center gap-4">
    <nav aria-label="Primary">
      <ul class="flex flex-wrap items-center justify-end gap-0.5 sm:gap-1">
        {
          nav.map((item) => {
            const active = isActive(item.href);
            const contact = item.href === "/contact";
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "block rounded-full px-2 py-1.5 text-[13px] transition-colors sm:px-3.5 sm:text-sm",
                    contact
                      ? "border border-line text-ink hover:border-ink"
                      : active
                        ? "bg-ink/[0.07] font-medium text-ink"
                        : "text-muted hover:text-ink",
                    contact && active && "border-ink",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <ul class="hidden items-center gap-3.5 border-l border-line pl-4 lg:flex">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              title={s.label}
              class="block text-muted transition-colors hover:text-ink"
            >
              <Icon name={s.icon} class="h-[17px] w-[17px]" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
