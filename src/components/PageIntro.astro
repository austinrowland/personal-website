---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<header class="mx-auto flex max-w-6xl flex-col gap-4 px-6 pt-12 pb-14 md:pt-20">
  <p class="label text-muted" data-reveal>{eyebrow}</p>
  <h1
    class="max-w-3xl font-display text-5xl leading-[1.05] tracking-tight sm:text-6xl"
    data-reveal
    style="--i:1"
  >
    {title}
  </h1>
  <slot />
</header>
