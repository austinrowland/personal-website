---
import "@fontsource/permanent-marker/400.css";
import "@fontsource/caveat/500.css";
import Photo from "./Photo.astro";
import type { GalleryPhoto } from "../data/photos";

interface Props {
  photo: GalleryPhoto;
  /** Card tilt in degrees, so a grid of prints looks hand-placed. */
  tilt?: number;
  /** Links the print instead of flipping it. */
  href?: string;
}

const { photo, tilt = 0, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="polaroid" style={`--tilt:${tilt}deg`} href={href} data-polaroid={href ? undefined : true}>
  {
    !href && (
      <button type="button" class="flip" aria-pressed="false" aria-label={`Flip the ${photo.caption} print`} />
    )
  }
  <div class="inner">
    <div class="face front">
      <Photo alt={photo.alt} name={photo.name} class="aspect-square" imgClass="film" sizes="(min-width: 768px) 22rem, 90vw" />
      <p class="caption">{photo.caption}</p>
    </div>
    {
      !href && (
        <div class="face back" aria-hidden="true">
          <p class="caption" aria-hidden="true">{photo.caption}</p>
          <p class="story" data-md-keep>{photo.story}</p>
          <p class="hint label" aria-hidden="true">tap to flip back</p>
        </div>
      )
    }
  </div>
</Tag>

<style>
  .polaroid {
    display: block;
    perspective: 1400px;
    cursor: pointer;
    transform: rotate(var(--tilt));
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .polaroid:hover,
  .polaroid:focus-within {
    transform: rotate(0deg) translateY(-4px);
  }
  .flip:focus-visible {
    outline: 2px solid var(--accent, #c2410c);
    outline-offset: 6px;
  }
  .inner {
    position: relative;
    display: block;
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .polaroid {
    position: relative;
  }
  .flip {
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: pointer;
  }
  .flip[aria-pressed="true"] {
    pointer-events: none;
  }
  .polaroid:has(.flip[aria-pressed="true"]) .inner {
    transform: rotateY(180deg);
  }
  .face {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    background: #f7f3ea;
    color: #1c1a17;
    padding: 0.8rem 0.8rem 1.1rem;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 12px 28px -12px rgb(0 0 0 / 0.35);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
    padding: 1.4rem;
    overflow-y: auto;
    background:
      repeating-linear-gradient(transparent 0 1.7rem, rgb(28 26 23 / 0.07) 1.7rem calc(1.7rem + 1px)),
      #f3eee2;
  }
  .caption {
    display: block;
    font-family: "Permanent Marker", "Marker Felt", "Comic Sans MS", cursive;
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-align: center;
    color: #24211e;
    transform: rotate(-1.2deg);
  }
  .back .caption {
    text-align: left;
    color: #6b655c;
    transform: none;
  }
  .story {
    font-family: "Caveat", "Bradley Hand", cursive;
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.7rem;
    color: #2c2a26;
  }
  .hint {
    margin-top: auto;
    color: #8a8378;
  }
  .polaroid :global(.print) {
    border-radius: 0;
  }
  .polaroid :global(img.film) {
    filter: sepia(0.14) saturate(0.9) contrast(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .polaroid,
    .inner {
      transition: none;
    }
  }
</style>
