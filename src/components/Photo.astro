---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getPhoto, getPhotoFocus } from "../lib/photos";

interface Props {
  src?: ImageMetadata;
  alt: string;
  /** Placeholder name shown until the real photo is added, e.g. "tedx-gt". */
  name?: string;
  caption?: string;
  class?: string;
  imgClass?: string;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  /** "contain" shows the whole photo inside the frame instead of cropping. */
  fit?: "cover" | "contain";
}

const {
  src,
  alt,
  name,
  caption,
  class: className = "aspect-[3/2]",
  imgClass = "",
  widths = [480, 800, 1200],
  sizes = "(min-width: 768px) 50vw, 100vw",
  loading = "lazy",
  fit = "cover",
} = Astro.props;

const image = src ?? getPhoto(name);
const focus = getPhotoFocus(name);
---

<figure class="flex flex-col gap-2">
  <div class:list={["print relative overflow-hidden", className]}>
    {
      image ? (
        <Image
          src={image}
          alt={alt}
          widths={[...new Set(widths.map((w) => Math.min(w, image.width)))]}
          sizes={sizes}
          loading={loading}
          class:list={[
            "h-full w-full",
            fit === "contain" ? "object-contain" : "object-cover",
            imgClass,
          ]}
          style={focus && fit === "cover" ? `object-position:${focus}` : undefined}
        />
      ) : (
        <div
          role="img"
          aria-label={`${alt} (photo coming soon)`}
          class="placeholder flex h-full w-full items-end p-3"
        >
          <span class="label text-muted">photo · {name ?? "coming soon"}</span>
        </div>
      )
    }
  </div>
  {caption && <figcaption class="label text-muted">{caption}</figcaption>}
</figure>
