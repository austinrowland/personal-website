---
/** Canoe under a mountain: "Row" + "Land", drawn as a woodblock print. Ink is the text color; a soft sun rises behind the peaks and the canoe uses the accent. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const shade = "color-mix(in oklab, currentColor 62%, var(--paper))";
---

<svg viewBox="0 0 32 32" aria-hidden="true" class={className}>
  <circle cx="22" cy="10" r="7.5" fill="color-mix(in oklab, var(--sun) 32%, var(--paper))" stroke="currentColor" stroke-width="0.5" />
  <path d="M1.5 21 L11 6 L16 13.5 L20.5 8.5 L30.5 21 Z" fill={shade} stroke="currentColor" stroke-width="0.7" stroke-linejoin="round" />
  <path d="M1.5 21 L11 6 L13 21 Z M13 21 L16 13.5 L20.5 8.5 L22 21 Z" fill="currentColor" />
  <path d="M11 6 L13.6 10 L12.2 9.2 L11 10.8 L9.6 9.4 L8.6 10.2 Z" fill="var(--paper)" stroke="currentColor" stroke-width="0.4" stroke-linejoin="round" />
  <path
    d="M2 25 a2 2 0 0 1 4 0 a2 2 0 0 1 4 0 M22 25 a2 2 0 0 1 4 0 a2 2 0 0 1 4 0 M2.8 25 a1.2 1.2 0 0 1 2.4 0 M6.8 25 a1.2 1.2 0 0 1 2.4 0 M22.8 25 a1.2 1.2 0 0 1 2.4 0 M26.8 25 a1.2 1.2 0 0 1 2.4 0"
    fill="none"
    stroke="currentColor"
    stroke-width="0.45"
    opacity="0.7"
  />
  <path d="M3.5 22.5 Q6 24 9 24 H23 Q26 24 28.5 22.5 Q25 28.5 16 28.5 Q7 28.5 3.5 22.5 Z" fill="var(--accent)" stroke="currentColor" stroke-width="0.6" stroke-linejoin="round" />
  <circle cx="14" cy="19.8" r="1.6" fill="var(--accent)" stroke="currentColor" stroke-width="0.5" />
  <path d="M18 18.5 L21.5 29.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
  <path d="M18 18.5 L21.5 29.5" stroke="var(--accent)" stroke-width="1.2" stroke-linecap="round" />
</svg>
