---
/** Canoe under a mountain: "Row" + "Land". A soft sun rises behind faceted peaks in the text color; canoe and paddler use the accent. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const shade = "color-mix(in oklab, currentColor 62%, var(--paper))";
---

<svg viewBox="0 0 32 32" aria-hidden="true" class={className}>
  <circle cx="22" cy="10" r="7.5" fill="color-mix(in oklab, var(--sun) 32%, var(--paper))" />
  <path d="M1.5 21 L11 6 L13 21 Z" fill="currentColor" />
  <path d="M11 6 L16 13.5 L13 21 Z" fill={shade} />
  <path d="M13 21 L16 13.5 L20.5 8.5 L22 21 Z" fill="currentColor" />
  <path d="M20.5 8.5 L30.5 21 L22 21 Z" fill={shade} />
  <path d="M11 6 L13.6 10 L12 9.4 L11 10.6 Z" fill="var(--paper)" />
  <path d="M3.5 22.5 Q6 24 9 24 H23 Q26 24 28.5 22.5 Q25 28.5 16 28.5 Q7 28.5 3.5 22.5 Z" fill="var(--accent)" />
  <circle cx="14" cy="19.8" r="1.6" fill="var(--accent)" />
  <path d="M12.4 24 L14 21.8 L15.6 24 Z" fill="var(--accent)" />
  <path d="M18 18.5 L21.5 29.5" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" />
</svg>
