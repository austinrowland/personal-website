<button
  type="button"
  data-theme-toggle
  class="label flex items-center gap-1.5 text-muted transition-colors hover:text-ink"
  aria-label="Toggle dark mode"
>
  <span
    aria-hidden="true"
    class="inline-block h-2.5 w-2.5 rounded-full border border-current bg-transparent dark:bg-current"
  ></span>
  <span class="hidden sm:inline">
    <span class="dark:hidden">light</span>
    <span class="hidden dark:inline">dark</span>
  </span>
</button>

<script>
  function initToggle() {
    const button = document.querySelector<HTMLButtonElement>(
      "[data-theme-toggle]",
    );
    if (!button || button.dataset.bound) return;
    button.dataset.bound = "true";
    const sync = () =>
      button.setAttribute(
        "aria-pressed",
        String(document.documentElement.dataset.theme === "dark"),
      );
    sync();
    button.addEventListener("click", () => {
      const next =
        document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      sync();
    });
  }
  document.addEventListener("astro:page-load", initToggle);
</script>
