---
import { markdownPath } from "../data/pages";
import { nav, site, socials } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";
const markdown = markdownPath(Astro.url.pathname);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const pagesMd = ["## Pages", "", "- [Home](/)", ...nav.map((n) => `- [${n.label}](${n.href})`)].join("\n");
const elsewhereMd = [
  "## Elsewhere",
  "",
  ...socials.map((s) => `- [${s.label}](${s.href})`),
  `- [Email](mailto:${site.email})`,
].join("\n");
const agentsMd = [
  "## For agents",
  "",
  "- [llms.txt](/llms.txt)",
  "- [llms-full.txt](/llms-full.txt)",
  "- [RSS](/rss.xml)",
].join("\n");
---

<section data-agent-view aria-label="This site as Markdown">
  <div class="agent-frame">
    <nav class="agent-nav" aria-label="Pages">
      <div class="chips">
        <a class="chip chip-home" href="/" aria-current={path === "/" ? "page" : undefined}>~/austinrowland</a>
        {
          nav.map((n) => (
            <a class="chip" href={n.href} aria-current={path === n.href || path.startsWith(`${n.href}/`) ? "page" : undefined}>
              {`${n.href}/`}
            </a>
          ))
        }
      </div>
      <div class="agent-bar">
        <span class="chip chip-path">{markdown}</span>
        <button type="button" class="chip" data-copy-markdown>copy</button>
      </div>
    </nav>
    <pre class="agent-page" data-markdown-src={markdown}>loading…</pre>
    <footer class="agent-foot">
      <div class="foot-cols">
        <pre data-agent-md data-md={pagesMd}></pre>
        <pre data-agent-md data-md={elsewhereMd}></pre>
        <pre data-agent-md data-md={agentsMd}></pre>
      </div>
      <p class="foot-line">{site.name} · {site.location}</p>
    </footer>
  </div>
</section>

<div class="view-switch fixed bottom-5 left-1/2 z-50 -translate-x-1/2" transition:persist>
  <div role="group" aria-label="View this site as" class="switch-group flex gap-1 rounded-full border p-1 shadow-sm backdrop-blur">
    <button type="button" data-view-mode="human" class="view-mode label flex items-center gap-2 rounded-full px-3 py-1.5">
      <span aria-hidden="true" class="dot"></span>human
    </button>
    <button type="button" data-view-mode="agent" class="view-mode label flex items-center gap-2 rounded-full px-3 py-1.5">
      <span aria-hidden="true" class="dot"></span>agent
    </button>
    <span aria-hidden="true" class="mx-1 w-px self-stretch bg-line"></span>
    <span class="theme-slot flex items-center px-2"><ThemeToggle /></span>
  </div>
</div>

<style>
  .view-switch,
  [data-agent-view] {
    display: none;
  }
  :global(html.js) .view-switch {
    display: block;
    transition: opacity 0.2s;
  }
  .view-switch.is-tucked:not(:has(:focus-visible)) {
    opacity: 0;
    pointer-events: none;
  }
  .switch-group {
    border-color: var(--color-line);
    background: color-mix(in srgb, var(--color-paper) 90%, transparent);
  }
  .view-mode {
    color: var(--color-muted);
  }
  .view-mode[aria-pressed="true"] {
    color: var(--color-ink);
    background: var(--color-line);
  }
  .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    border: 1px solid currentColor;
  }
  .view-mode[aria-pressed="true"] .dot {
    background: currentColor;
  }

  /* Agent palette follows the light/dark theme. */
  :global(html) {
    --agent-bg: #f7f7f5;
    --agent-text: #2a2a2a;
    --agent-strong: #0d0d0d;
    --agent-muted: #6e6e6e;
    --agent-url: #8c8c8c;
    --agent-faint: #9a9a9a;
    --agent-rule: #e2e2de;
    --agent-chip: #d9d9d5;
    --agent-switch-line: #d6d6d2;
    --agent-hover: #a3a39f;
    --agent-current: #8a8a86;
    --agent-pressed: #e4e4e0;
    --agent-switch-bg: rgba(250, 250, 248, 0.9);
  }
  :global(html[data-theme="dark"]) {
    --agent-bg: #111;
    --agent-text: #e6e6e6;
    --agent-strong: #f2f2f2;
    --agent-muted: #8a8a8a;
    --agent-url: #7a7a7a;
    --agent-faint: #6a6a6a;
    --agent-rule: #262626;
    --agent-chip: #2e2e2e;
    --agent-switch-line: #333;
    --agent-hover: #4a4a4a;
    --agent-current: #5a5a5a;
    --agent-pressed: #3a3a3a;
    --agent-switch-bg: rgba(40, 40, 40, 0.9);
  }
  /* Agent mode: the whole site becomes Markdown on a terminal-style page. */
  :global(html[data-reader="agent"]) {
    background: var(--agent-bg);
    color-scheme: light;
  }
  :global(html[data-reader="agent"] body) {
    background: var(--agent-bg);
  }
  :global(html[data-reader="agent"] [data-human-view]) {
    display: none !important;
  }
  :global(html[data-reader="agent"] [data-agent-view]) {
    display: block;
  }
  :global(html[data-reader="agent"]) .switch-group {
    border-color: var(--agent-switch-line);
    background: var(--agent-switch-bg);
  }
  :global(html[data-reader="agent"][data-theme="dark"]) {
    color-scheme: dark;
  }
  :global(html[data-reader="agent"]) .view-mode {
    color: var(--agent-muted);
  }
  :global(html[data-reader="agent"]) .view-mode[aria-pressed="true"] {
    color: var(--agent-strong);
    background: var(--agent-pressed);
  }
  /* The Markdown view fills the window: a full-height frame, a sticky row of page paths, a wide reading column. */
  [data-agent-view] {
    min-height: 100vh;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.75;
    color: var(--agent-text);
  }
  .agent-frame {
    min-height: 100vh;
    margin: 0 clamp(0.5rem, 2vw, 2rem);
    border-left: 1px solid var(--agent-rule);
    border-right: 1px solid var(--agent-rule);
    padding: 0 clamp(1rem, 3vw, 2.5rem) 7rem;
  }
  .agent-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    background: var(--agent-bg);
    font-size: 13px;
  }
  .chips,
  .agent-bar {
    display: flex;
    gap: 0.4rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .agent-bar {
    flex-shrink: 0;
  }
  .chip {
    flex-shrink: 0;
    border: 1px solid var(--agent-chip);
    padding: 0.2rem 0.6rem;
    color: var(--agent-muted);
    white-space: nowrap;
    text-decoration: none;
  }
  [data-agent-view] a.chip:hover,
  .agent-bar button:hover {
    color: var(--agent-strong);
    text-decoration: none;
    border-color: var(--agent-hover);
  }
  [data-agent-view] a.chip[aria-current="page"],
  [data-agent-view] a.chip-home {
    color: var(--agent-strong);
  }
  [data-agent-view] a.chip[aria-current="page"] {
    border-color: var(--agent-current);
  }
  .agent-bar button {
    cursor: pointer;
  }
  [data-agent-view] pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin: 0;
    font: inherit;
  }
  .agent-page {
    max-width: 84ch;
    margin: clamp(2.5rem, 9vh, 6rem) auto 0 !important;
  }
  .agent-foot {
    max-width: 84ch;
    margin: 6rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--agent-rule);
    font-size: 13px;
  }
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2rem;
  }
  .foot-line {
    margin-top: 3rem;
    color: var(--agent-faint);
  }
  @media (max-width: 640px) {
    [data-agent-view] {
      font-size: 13px;
    }
    .chip-path {
      display: none;
    }
  }
  [data-agent-view] :global(a) {
    color: var(--agent-strong);
    text-decoration: none;
  }
  [data-agent-view] :global(a:hover) {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }
  [data-agent-view] :global(.md-url) {
    color: var(--agent-url);
  }
</style>
<script>
  type Mode = "human" | "agent";
  const cache = new Map<string, string>();
  const SITE = "https://austinrowland.com";

  const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  /** Same-site Markdown links navigate to the HTML page (agent mode stays on). */
  function hrefFor(url: string): string {
    let path = url.startsWith(SITE) ? url.slice(SITE.length) || "/" : url;
    if (path.startsWith("/") && path.endsWith(".md") && !path.startsWith("//")) {
      path = path === "/index.md" ? "/" : path.slice(0, -3);
    }
    return path;
  }

  /** Escapes Markdown and makes its links clickable while keeping the raw syntax visible. */
  function render(md: string): string {
    return escape(md).replace(/(!?)\[([^\]\n]*)\]\(([^)\s]+)\)/g, (_, bang, label, url) => {
      const href = hrefFor(url.replace(/&amp;/g, "&"));
      const external = /^https?:/.test(href) ? ' target="_blank" rel="noopener noreferrer"' : "";
      return `${bang}<a href="${href}"${external}>[${label}]</a><span class="md-url">(${url})</span>`;
    }).replace(/&lt;([^\s<>]+?)&gt;/g, (raw, target: string) => {
      const url = target.replace(/&amp;/g, "&");
      const href = /^[a-z][a-z0-9+.-]*:/i.test(url) ? hrefFor(url) : url.includes("@") ? `mailto:${url}` : "";
      if (!href) return raw;
      const external = /^https?:/.test(href) ? ' target="_blank" rel="noopener noreferrer"' : "";
      return `&lt;<a href="${href}"${external}>${target}</a>&gt;`;
    });
  }

  async function loadMarkdown() {
    document.querySelectorAll<HTMLPreElement>("[data-agent-md]").forEach((pre) => {
      if (!pre.dataset.rendered) {
        pre.innerHTML = render(pre.dataset.md ?? "");
        pre.dataset.rendered = "true";
      }
    });
    const pre = document.querySelector<HTMLPreElement>("[data-markdown-src]");
    const src = pre?.dataset.markdownSrc;
    if (!pre || !src) return;
    if (!cache.has(src)) {
      try {
        const res = await fetch(src, { headers: { Accept: "text/markdown" } });
        if (!res.ok) {
          pre.textContent = `Could not load ${src} (${res.status}). Switch views to retry.`;
          return;
        }
        cache.set(src, await res.text());
      } catch {
        pre.textContent = `Could not load ${src}. Switch views to retry.`;
        return;
      }
    }
    pre.innerHTML = render(cache.get(src) ?? "");
  }

  function currentMode(): Mode {
    return document.documentElement.dataset.reader === "agent" ? "agent" : "human";
  }

  function apply(mode: Mode, { save = true } = {}) {
    document.documentElement.dataset.reader = mode;
    if (save) {
      try {
        localStorage.setItem("view", mode);
      } catch {}
    }
    document.querySelectorAll<HTMLButtonElement>("[data-view-mode]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b.dataset.viewMode === mode));
    });
    if (mode === "agent") loadMarkdown();
  }

  let wiping = false;
  /**
   * Square tiles in the next view's background sweep out from the switch, the view flips under full cover,
   * then the tiles clear in the same order. Some tiles carry a faint inner pixel, like the homepage strokes.
   */
  function pixelWipe(mode: Mode, from: DOMRect, swap: () => void) {
    if (wiping || mode === currentMode() || matchMedia("(prefers-reduced-motion: reduce)").matches) return swap();
    const w = innerWidth;
    const h = innerHeight;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const cv = document.createElement("canvas");
    const ctx = cv.getContext("2d");
    if (!ctx) return swap();
    wiping = true;
    cv.setAttribute("aria-hidden", "true");
    cv.style.cssText = "position:fixed;inset:0;width:100%;height:100%;z-index:45;pointer-events:none";
    cv.width = Math.ceil(w * dpr);
    cv.height = Math.ceil(h * dpr);
    ctx.scale(dpr, dpr);
    const css = getComputedStyle(document.documentElement);
    const fill = css.getPropertyValue(mode === "agent" ? "--agent-bg" : "--paper").trim() || "#fff";
    const speck = css.getPropertyValue(mode === "agent" ? "--agent-text" : "--ink").trim() || "#000";

    const T = Math.round(Math.min(40, Math.max(24, Math.min(w, h) / 22)));
    const ox = from.left + from.width / 2;
    const oy = from.top + from.height / 2;
    const far = Math.max(Math.hypot(ox, oy), Math.hypot(w - ox, oy), Math.hypot(ox, h - oy), Math.hypot(w - ox, h - oy));
    const tiles: { x: number; y: number; at: number; inner: number[] | null }[] = [];
    for (let y = 0; y < h; y += T)
      for (let x = 0; x < w; x += T) {
        const d = Math.hypot(x + T / 2 - ox, y + T / 2 - oy) / far;
        const inner = Math.random() < 0.3 ? [Math.random() * 0.5, Math.random() * 0.5, 0.25 + Math.random() * 0.25] : null;
        tiles.push({ x, y, at: d * 0.62 + Math.random() * 0.23, inner });
      }
    const GROW = 0.15;
    const IN = 420;
    const OUT = 480;
    const ease = (v: number) => 1 - (1 - v) ** 3;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    document.body.append(cv);

    let start = 0;
    let swapped = false;
    const frame = (now: number) => {
      start ||= now;
      const t = now - start;
      if (t >= IN && !swapped) {
        swapped = true;
        swap();
      }
      const u = swapped ? (t - IN) / OUT : t / IN;
      ctx.clearRect(0, 0, w, h);
      for (const tile of tiles) {
        const p = clamp((u - tile.at) / GROW);
        const k = ease(swapped ? 1 - p : p);
        if (k <= 0) continue;
        const s = (T + 1) * k;
        const x = tile.x + (T - s) / 2;
        const y = tile.y + (T - s) / 2;
        ctx.globalAlpha = 1;
        ctx.fillStyle = fill;
        ctx.fillRect(x, y, s, s);
        if (tile.inner) {
          const [fx, fy, fs] = tile.inner;
          ctx.globalAlpha = 0.07;
          ctx.fillStyle = speck;
          ctx.fillRect(x + fx * s, y + fy * s, fs * s, fs * s);
        }
      }
      if (swapped && u >= 1) {
        cv.remove();
        wiping = false;
      } else requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  function init() {
    const param = new URLSearchParams(location.search).get("view");
    if (param === "agent" || param === "human") apply(param);
    else apply(currentMode(), { save: false });

    document.querySelectorAll<HTMLButtonElement>("[data-view-mode]").forEach((b) => {
      if (b.dataset.bound) return;
      b.dataset.bound = "true";
      b.addEventListener("click", () => {
        const mode = b.dataset.viewMode as Mode;
        pixelWipe(mode, b.getBoundingClientRect(), () => {
          apply(mode);
          window.scrollTo({ top: 0 });
        });
      });
    });

    const copy = document.querySelector<HTMLButtonElement>("[data-copy-markdown]");
    if (copy && !copy.dataset.bound) {
      copy.dataset.bound = "true";
      copy.addEventListener("click", async () => {
        const src = document.querySelector<HTMLPreElement>("[data-markdown-src]")?.dataset.markdownSrc ?? "";
        try {
          await navigator.clipboard.writeText(cache.get(src) ?? "");
          copy.textContent = "copied";
          setTimeout(() => (copy.textContent = "copy"), 1500);
        } catch {}
      });
    }
  }
  document.addEventListener("astro:page-load", init);

  /** Embeds marked data-tuck-switch scroll internally, so the switch hides while one sits under it (unless it has keyboard focus). */
  function tuck() {
    const sw = document.querySelector<HTMLElement>(".view-switch");
    if (!sw) return;
    const zone = sw.getBoundingClientRect();
    const covered = [...document.querySelectorAll("[data-tuck-switch]")].some((el) => {
      const r = el.getBoundingClientRect();
      return r.top < zone.bottom && r.bottom > zone.top;
    });
    sw.classList.toggle("is-tucked", covered);
  }
  addEventListener("scroll", tuck, { passive: true });
  addEventListener("resize", tuck);
  document.addEventListener("astro:page-load", tuck);
</script>
