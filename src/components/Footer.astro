---
import { site } from "../data/site";
import { markdownPath } from "../data/pages";
const year = new Date().getFullYear();
const markdown = markdownPath(Astro.url.pathname);
---

<footer class="flex flex-col items-center gap-2 px-6 pt-10 pb-24 text-center">
  <p class="label text-muted">{site.name} · {site.location} · {year}</p>
  <p class="label text-muted">
    for agents: <a class="link" href="/llms.txt">llms.txt</a> ·
    <a class="link" href={markdown}>this page as markdown</a> ·
    <a class="link" href="/rss.xml">rss</a>
  </p>
</footer>
