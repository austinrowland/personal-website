---
/**
 * Scroll-driven Polaroid 600 intro for the Photos page: a pinned stage above the desk. The slot holds the hero text.
 * Without JS, with reduced motion, in Agent view, or with ?intro=off, it collapses to a plain page header.
 */
const MODEL = "/models/polaroid-600.glb";
---

<section class="scrolly" data-scrolly data-model={MODEL}>
  <script is:inline define:vars={{ MODEL }}>
    (() => {
      const d = document.documentElement;
      const play =
        !matchMedia("(prefers-reduced-motion: reduce)").matches &&
        d.dataset.reader !== "agent" &&
        !/[?&]intro=off\b/.test(location.search) &&
        !!document.createElement("canvas").getContext("webgl2");
      if (play) {
        d.dataset.intro = "play";
        const link = document.createElement("link");
        link.rel = "preload";
        link.as = "fetch";
        link.crossOrigin = "anonymous";
        link.href = MODEL;
        document.head.append(link);
      } else delete d.dataset.intro;
    })();
  </script>
  <div class="stage" data-stage style="--p:0">
    <div class="backdrop" aria-hidden="true"></div>
    <canvas aria-hidden="true"></canvas>
    <div class="hero">
      <slot />
    </div>
    <p class="cue label" aria-hidden="true">scroll to take the photo ↓</p>
    <button type="button" class="skip label" data-skip>skip to the photos</button>
    <div class="flash" data-flash aria-hidden="true"></div>
  </div>
</section>

<style>
  .backdrop,
  canvas,
  .cue,
  .skip,
  .flash {
    display: none;
  }

  :global(html[data-intro="play"]) .scrolly {
    /* One screen pinned, plus the scroll distance the sequence plays over. */
    height: calc(100svh + 250svh);
  }
  :global(html[data-intro="play"]) .stage {
    position: sticky;
    top: 0;
    z-index: 30;
    height: 100svh;
    overflow: hidden;
    pointer-events: none;
  }
  :global(html[data-intro="play"]) :is(.backdrop, canvas, .flash) {
    display: block;
    position: absolute;
    inset: 0;
  }
  :global(html[data-intro="play"]) canvas {
    width: 100%;
    height: 100%;
  }
  .backdrop {
    background: radial-gradient(ellipse at 50% 40%, var(--paper), var(--surface) 80%);
    /* Fades as the view pulls back, so the 3D print lands on the real desk rising underneath. */
    opacity: clamp(0, calc((0.92 - var(--p)) * 5), 1);
  }
  :global(html[data-intro="play"][data-landed]) canvas {
    visibility: hidden;
  }

  /* The headline sits under the floating camera, then grows and fades as you scroll, like the hero on ascendstudio.so. */
  :global(html[data-intro="play"]) .hero {
    position: absolute;
    inset: 58svh 0 auto;
    display: grid;
    justify-items: center;
    padding-inline: 1.5rem;
    text-align: center;
  }
  :global(html[data-intro="play"]) .hero :global(> *) {
    grid-area: 1 / 1;
  }
  :global(html[data-intro="play"]) .hero :global([data-beat="1"]) {
    opacity: clamp(0, calc(1 - (var(--p) - 0.02) * 12), 1);
    transform: scale(calc(1 + var(--p) * 1.2));
    transform-origin: 50% 0;
  }
  :global(html[data-intro="play"]) .hero :global([data-beat="2"]) {
    opacity: clamp(0, min(calc((var(--p) - 0.11) * 12), calc((0.32 - var(--p)) * 12)), 1);
    transform: translateY(calc((0.2 - var(--p)) * 60px));
  }
  :global(html[data-intro="play"]) .hero :global([data-beat]) {
    align-items: center;
    padding-block: 0;
  }

  :global(html[data-intro="play"]) .cue {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    /* Above the Human/Agent pill, on the first screen, which starts below the site header. */
    bottom: calc(5rem + var(--offset, 0px));
    text-align: center;
    color: var(--muted);
    opacity: clamp(0, calc(1 - var(--p) * 25), 1);
  }
  :global(html[data-intro="play"]) .skip {
    display: block;
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    color: var(--muted);
    pointer-events: auto;
    opacity: clamp(0, calc((0.9 - var(--p)) * 10), 1);
  }
  :global(html[data-intro="play"][data-landed]) .skip {
    visibility: hidden;
  }
  .skip:hover {
    color: var(--ink);
  }
  .flash {
    background: #fff;
    opacity: 0;
  }
  @media (max-width: 639px) {
    :global(html[data-intro="play"]) .hero {
      inset-block-start: 54svh;
    }
    :global(html[data-intro="play"]) .skip {
      right: 0;
      left: 0;
      bottom: 3.75rem;
    }
    :global(html[data-intro="play"]) .cue {
      bottom: calc(5.5rem + var(--offset, 0px));
    }
    :global(html[data-intro="play"]) .hero :global([data-beat="2"] p) {
      font-size: 1rem;
    }
    :global(html[data-intro="play"]) .hero :global([data-beat="2"]) {
      inset-block-start: -12svh;
      position: relative;
    }
  }
</style>

<script>
  import type { Landing } from "../lib/polaroid600";

  /** The face-down print on the desk that the 3D print lands on. */
  function landing(): Landing | null {
    const el = document.querySelector<HTMLElement>("[data-soon]");
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return {
      x: r.left + r.width / 2,
      y: r.top + r.height / 2,
      width: el.offsetWidth,
      height: el.offsetHeight,
      tilt: Number(el.dataset.tilt ?? 0),
    };
  }

  document.addEventListener("astro:page-load", async () => {
    const root = document.querySelector<HTMLElement>("[data-scrolly]");
    const doc = document.documentElement;
    if (!root || doc.dataset.intro !== "play" || root.dataset.bound) return;
    root.dataset.bound = "true";
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const flash = root.querySelector<HTMLElement>("[data-flash]")!;
    const desk = document.querySelector<HTMLElement>("[data-desk]");
    let stop: (() => void) | undefined;

    const offset = () => stage.style.setProperty("--offset", `${root.offsetTop}px`);
    offset();
    addEventListener("resize", offset);
    const progress = () => {
      const length = root.offsetHeight - innerHeight;
      return Math.min(Math.max(-root.getBoundingClientRect().top / length, 0), 1);
    };
    const giveUp = () => {
      stop?.();
      // Keep whatever was on screen in place as the pinned stage collapses, anchored on the desk.
      const before = desk?.getBoundingClientRect().top ?? 0;
      delete doc.dataset.intro;
      delete doc.dataset.landed;
      const shift = (desk?.getBoundingClientRect().top ?? 0) - before;
      if (desk && before < innerHeight && shift) scrollBy({ top: shift, behavior: "instant" });
    };

    root.querySelector("[data-skip]")!.addEventListener("click", () => {
      scrollTo({ top: root.offsetTop + root.offsetHeight - innerHeight, behavior: "smooth" });
    });
    document.addEventListener(
      "astro:before-swap",
      () => {
        stop?.();
        removeEventListener("resize", offset);
        delete doc.dataset.intro;
        delete doc.dataset.landed;
      },
      { once: true },
    );

    try {
      const { mountPolaroid600, span, TIMELINE } = await import("../lib/polaroid600");
      stop = mountPolaroid600(root.querySelector("canvas")!, root.dataset.model!, {
        progress,
        landing,
        onReady: () => {},
        onError: giveUp,
        onFrame: (p, f) => {
          stage.style.setProperty("--p", p.toFixed(4));
          flash.style.opacity = String(0.92 * Math.min(f * 1.4, 1));
          desk?.style.setProperty("--develop", span(p, [0.85, 1]).toFixed(3));
          if (p >= 0.985) doc.dataset.landed = "";
          else delete doc.dataset.landed;
        },
      });
    } catch {
      giveUp();
    }
  });
</script>
