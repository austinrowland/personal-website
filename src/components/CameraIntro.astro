---
/** Full-screen Polaroid 600 intro for the Photos page. Skipped for reduced motion, Agent view, or ?intro=off. */
const MODEL = "/models/polaroid-600.glb";
---

<div class="camera-intro" data-camera-intro data-model={MODEL} aria-hidden="true">
  <script is:inline define:vars={{ MODEL }}>
    (() => {
      const d = document.documentElement;
      const play =
        !matchMedia("(prefers-reduced-motion: reduce)").matches &&
        d.dataset.reader !== "agent" &&
        !/[?&]intro=off\b/.test(location.search);
      if (play) {
        d.dataset.intro = "play";
        const link = document.createElement("link");
        link.rel = "preload";
        link.as = "fetch";
        link.crossOrigin = "anonymous";
        link.href = MODEL;
        document.head.append(link);
      } else delete d.dataset.intro;
    })();
  </script>
  <canvas></canvas>
  <p class="cheese label">say cheese</p>
  <button type="button" class="skip label" data-skip tabindex="-1">skip intro</button>
  <div class="flash" data-flash></div>
</div>

<style>
  .camera-intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 60;
    transition: opacity 0.9s ease;
  }
  :global(html[data-intro="play"]) .camera-intro,
  .camera-intro.is-leaving {
    display: block;
  }
  .camera-intro.is-leaving {
    opacity: 0;
    pointer-events: none;
  }
  /* As the view pulls back, the backdrop fades so the 3D print lands on the real desk. */
  .camera-intro::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 45%, var(--paper), var(--surface) 75%);
    transition: opacity 1.4s ease;
  }
  .camera-intro.is-revealing {
    pointer-events: none;
  }
  .camera-intro.is-revealing::before {
    opacity: 0;
  }
  .camera-intro.is-revealing .cheese {
    visibility: hidden;
  }
  .skip {
    pointer-events: auto;
  }
  canvas {
    position: relative;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .cheese {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + clamp(4.5rem, 24vw, 14rem));
    text-align: center;
    color: var(--muted);
    opacity: 0;
    animation: cheese 0.6s ease 0.6s forwards;
  }
  .skip {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    color: var(--muted);
  }
  .skip:hover {
    color: var(--ink);
  }
  .flash {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }
  .flash.is-on {
    animation: flash 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  @keyframes cheese {
    to {
      opacity: 1;
    }
  }
  @keyframes flash {
    0% {
      opacity: 0;
    }
    8% {
      opacity: 0.92;
    }
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  import type { Landing } from "../lib/polaroid600";

  /** The face-down print on the desk that the 3D print lands on, scrolled into view if needed. */
  function landing(): Landing | null {
    const el = document.querySelector<HTMLElement>("[data-soon]");
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return {
      x: r.left + r.width / 2,
      y: r.top + r.height / 2,
      width: el.offsetWidth,
      height: el.offsetHeight,
      tilt: Number(el.dataset.tilt ?? 0),
    };
  }

  function bringDeskIntoView() {
    const el = document.querySelector<HTMLElement>("[data-soon]");
    if (!el) return;
    const r = el.getBoundingClientRect();
    const overflow = r.bottom + 32 - innerHeight;
    if (overflow > 0) scrollBy({ top: Math.min(overflow, r.top - 24), behavior: "instant" });
  }

  document.addEventListener("astro:page-load", async () => {
    const root = document.querySelector<HTMLElement>("[data-camera-intro]");
    const doc = document.documentElement;
    if (!root || doc.dataset.intro !== "play" || root.dataset.bound) return;
    root.dataset.bound = "true";
    root.setAttribute("aria-hidden", "false");
    const skip = root.querySelector<HTMLButtonElement>("[data-skip]")!;
    skip.tabIndex = 0;
    const flash = root.querySelector<HTMLElement>("[data-flash]")!;
    let stop: (() => void) | undefined;
    let finished = false;

    const finish = () => {
      if (finished) return;
      finished = true;
      doc.dataset.intro = "done";
      root.classList.add("is-leaving");
      setTimeout(() => {
        stop?.();
        root.remove();
      }, 900);
    };
    skip.addEventListener("click", finish);
    // Gives up if the model takes too long to arrive; the whole sequence runs about 5.5 seconds once loaded.
    const safety = setTimeout(finish, 12000);
    document.addEventListener(
      "astro:before-swap",
      () => {
        clearTimeout(safety);
        stop?.();
        delete doc.dataset.intro;
      },
      { once: true },
    );

    bringDeskIntoView();
    try {
      const { playPolaroid600 } = await import("../lib/polaroid600");
      if (finished) return;
      stop = playPolaroid600(root.querySelector("canvas")!, root.dataset.model!, {
        landing,
        onFlash: () => flash.classList.add("is-on"),
        onReveal: () => root.classList.add("is-revealing"),
        onLand: finish,
        onError: finish,
      });
    } catch {
      finish();
    }
  });
</script>
