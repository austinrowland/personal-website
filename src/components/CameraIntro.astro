---
/**
 * Scroll-driven Polaroid 600 intro for the Memories page: a pinned stage above the desk. The slot holds the hero text.
 * Without JS, with reduced motion, in Agent view, or with ?intro=off, it collapses to a plain page header.
 * Scroll drives the sequence from the start, with a still of the camera; the live 3D camera fades in over the still
 * once it has drawn, and if it can't load (no WebGL2, slow network, lost GPU context) the still plays the sequence.
 */
// Gzipped on disk: meshopt-compressed GLB still shrinks by half, and hosts don't compress model files themselves.
import MODEL from "../assets/models/polaroid-600.glb.gz?url";
// A still of the first frame (rendered at a 778×1000 canvas), shown until the live camera has drawn.
import poster from "../assets/models/polaroid-600-poster.webp";
const POSTER = poster.src;
---

<section class="scrolly" data-scrolly data-model={MODEL}>
  <script is:inline define:vars={{ MODEL, POSTER }}>
    (() => {
      const d = document.documentElement;
      const play =
        !matchMedia("(prefers-reduced-motion: reduce)").matches &&
        d.dataset.reader !== "agent" &&
        !/[?&]intro=off\b/.test(location.search);
      if (play) {
        d.dataset.intro = "play";
        const still = document.createElement("link");
        still.rel = "preload";
        still.as = "image";
        still.fetchPriority = "high";
        still.href = POSTER;
        document.head.append(still);
        if ("DecompressionStream" in window && document.createElement("canvas").getContext("webgl2")) {
          d.dataset.live3d = "";
          const link = document.createElement("link");
          link.rel = "preload";
          link.as = "fetch";
          link.crossOrigin = "anonymous";
          link.href = MODEL;
          document.head.append(link);
        } else delete d.dataset.live3d;
      } else delete d.dataset.intro;
    })();
  </script>
  <div class="stage" data-stage style="--p:0">
    <div class="backdrop" aria-hidden="true"></div>
    <img class="poster" src={POSTER} alt="" aria-hidden="true" width={poster.width} height={poster.height} loading="lazy" />
    <canvas aria-hidden="true"></canvas>
    <div class="hero">
      <slot />
    </div>
    <p class="cue label" aria-hidden="true">scroll to take the photo ↓</p>
    <button type="button" class="skip label" data-skip>skip to the photos</button>
    <div class="flash" data-flash aria-hidden="true"></div>
  </div>
</section>

<style>
  .backdrop,
  canvas,
  .cue,
  .skip,
  .flash {
    display: none;
  }

  :global(html[data-intro="play"]) .scrolly {
    /* One screen pinned, plus the scroll distance the sequence plays over. */
    height: calc(100svh + 310svh);
  }
  :global(html[data-intro="play"]) .stage {
    position: sticky;
    top: 0;
    z-index: 30;
    height: 100svh;
    overflow: hidden;
    pointer-events: none;
  }
  :global(html[data-intro="play"]) :is(.backdrop, canvas, .flash) {
    display: block;
    position: absolute;
    inset: 0;
  }
  :global(html[data-intro="play"]) canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .stage[data-live] canvas {
    opacity: 1;
  }
  .poster {
    display: none;
  }
  :global(html[data-intro="play"]) .stage {
    container-type: size;
    /* The 3D view fits the stage height on wide screens and the width on narrow ones (below a 0.778 aspect). */
    --u: min(100cqh, 128.6cqw);
  }
  /*
    Same place and size as the camera on the canvas at rest: its size scales with --u, and its height on screen stays
    roughly fixed, so part of the offset from the stage center follows the stage height instead. Until the live camera
    draws, the still stands in for it through the sequence: it moves in, flashes, then shrinks and fades as the desk
    rises.
  */
  :global(html[data-intro="play"]) .poster {
    display: block;
    position: absolute;
    left: calc(50% - 0.184 * var(--u));
    top: calc(50% - 13cqh - 0.163 * var(--u));
    width: calc(0.368 * var(--u));
    height: auto;
    opacity: var(--camera, 1);
    transform: scale(calc((1 + var(--approach, 0) * 0.8) * (1 - var(--zoom, 0) * 0.5)));
    transform-origin: 50% 70%;
    transition:
      opacity 0.4s ease,
      visibility 0s 0.4s;
  }
  .stage[data-live] .poster {
    opacity: 0;
    visibility: hidden;
  }
  .backdrop {
    /* Same color as the page, so the site header above it reads as one surface. */
    background: var(--paper);
    /* Fades as the view pulls back, so the 3D print lands on the real desk rising underneath. */
    opacity: clamp(0, calc((0.935 - var(--p)) * 6.2), 1);
  }
  :global(html[data-intro="play"][data-landed]) canvas {
    visibility: hidden;
  }

  /* The headline sits under the floating camera, then grows and fades as you scroll, like the hero on ascendstudio.so. */
  :global(html[data-intro="play"]) .hero {
    position: absolute;
    inset: 58svh 0 auto;
    display: grid;
    justify-items: center;
    padding-inline: 1.5rem;
    text-align: center;
  }
  :global(html[data-intro="play"]) .hero :global(> *) {
    grid-area: 1 / 1;
  }
  :global(html[data-intro="play"]) .hero :global([data-beat="1"]) {
    opacity: clamp(0, calc(1 - (var(--p) - 0.016) * 15), 1);
    transform: scale(calc(1 + var(--p) * 1.5));
    transform-origin: 50% 0;
  }
  /* Held on screen for about 70svh of scrolling, and gone before the camera starts moving in (TIMELINE.approach). */
  :global(html[data-intro="play"]) .hero :global([data-beat="2"]) {
    opacity: clamp(0, min(calc((var(--p) - 0.081) * 21), calc((0.403 - var(--p)) * 21)), 1);
    transform: translateY(calc(max(0, 0.129 - var(--p)) * 300px));
  }
  :global(html[data-intro="play"]) .hero :global([data-beat]) {
    align-items: center;
    padding-block: 0;
  }

  :global(html[data-intro="play"]) .cue {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    /* Just under the headline (--cue-top is measured), or above the Human/Agent pill until it's measured. */
    top: calc(var(--cue-top, 100svh - 6rem) + 1rem);
    text-align: center;
    color: var(--muted);
    opacity: clamp(0, calc(1 - var(--p) * 31), 1);
  }
  :global(html[data-intro="play"]) .cue[hidden] {
    display: none;
  }
  :global(html[data-intro="play"]) .skip {
    display: block;
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    color: var(--muted);
    pointer-events: auto;
    opacity: clamp(0, calc((0.92 - var(--p)) * 12), 1);
  }
  :global(html[data-intro="play"][data-landed]) .skip {
    visibility: hidden;
  }
  .skip:hover {
    color: var(--ink);
  }
  .flash {
    background: #fff;
    opacity: 0;
  }
  @media (max-width: 639px) {
    :global(html[data-intro="play"]) .skip {
      right: 0;
      left: 0;
      bottom: 3.75rem;
    }
    /* Start the headline right under the camera (whose bottom is at 37cqh + 0.171u) and keep it to a size that leaves
       room for the cue above the Human/Agent pill. */
    :global(html[data-intro="play"]) .hero {
      inset-block-start: calc(37cqh + 0.171 * var(--u) + 0.5rem);
    }
    :global(html[data-intro="play"]) .hero :global([data-beat="1"]) {
      padding-block-start: 0;
    }
    :global(html[data-intro="play"]) .hero :global([data-beat="1"] h1) {
      font-size: clamp(2rem, 9.5cqw, 2.75rem);
    }
    /* On phones the paragraph is long: size it to end above the skip link. */
    :global(html[data-intro="play"]) .hero :global([data-beat="2"] p) {
      font-size: clamp(0.8125rem, 2.1cqh, 1rem);
      line-height: 1.45;
    }
  }
</style>

<script>
  import type { Landing } from "../lib/polaroid600";
  import { TIMELINE, easeInOut, flashAt, span } from "../lib/cameraTimeline";

  let engine: Promise<typeof import("../lib/polaroid600")> | undefined;
  const loadEngine = () => (engine ??= import("../lib/polaroid600"));
  const models = new Map<string, Promise<ArrayBuffer>>();

  /** Downloads and gunzips the model once per page session; repeat visits through the client router reuse it. */
  function loadModel(url: string) {
    let model = models.get(url);
    if (!model) {
      model = fetch(url)
        .then((res) => {
          if (!res.ok) throw new Error(`Model request failed: ${res.status}`);
          return res.arrayBuffer();
        })
        .then((data) => {
          const bytes = new Uint8Array(data);
          // A server that already decoded the gzip (Content-Encoding) hands over the plain GLB.
          if (bytes[0] !== 0x1f || bytes[1] !== 0x8b) return data;
          return new Response(new Blob([data]).stream().pipeThrough(new DecompressionStream("gzip"))).arrayBuffer();
        });
      model.catch(() => models.delete(url));
      models.set(url, model);
    }
    return model;
  }

  // Start both downloads as soon as this module runs, instead of after the page has finished loading.
  if (document.documentElement.dataset.intro === "play" && "live3d" in document.documentElement.dataset) {
    const url = document.querySelector<HTMLElement>("[data-scrolly]")?.dataset.model;
    if (url) {
      loadEngine().catch(() => {});
      loadModel(url).catch(() => {});
    }
  }

  /** The face-down print on the desk that the 3D print lands on. */
  function landing(): Landing | null {
    const el = document.querySelector<HTMLElement>("[data-soon]");
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return {
      x: r.left + r.width / 2,
      y: r.top + r.height / 2,
      width: el.offsetWidth,
      height: el.offsetHeight,
      tilt: Number(el.dataset.tilt ?? 0),
    };
  }

  document.addEventListener("astro:page-load", async () => {
    const root = document.querySelector<HTMLElement>("[data-scrolly]");
    const doc = document.documentElement;
    if (!root || doc.dataset.intro !== "play" || root.dataset.bound) return;
    root.dataset.bound = "true";
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const flash = root.querySelector<HTMLElement>("[data-flash]")!;
    const desk = document.querySelector<HTMLElement>("[data-desk]");
    const poster = root.querySelector<HTMLImageElement>(".poster")!;
    let stop: (() => void) | undefined;
    let raf = 0;

    const hero = root.querySelector<HTMLElement>(".hero")!;
    const title = hero.querySelector<HTMLElement>('[data-beat="1"] h1');
    const cue = root.querySelector<HTMLElement>(".cue")!;
    const offset = () => {
      stage.style.setProperty("--offset", `${root.offsetTop}px`);
      // The cue sits right under the headline, however many lines it wraps to (offsets ignore the scroll scale).
      if (!title) return;
      const top = hero.offsetTop + title.offsetTop + title.offsetHeight;
      stage.style.setProperty("--cue-top", `${top}px`);
      // On short screens there's no room between the headline and the Human/Agent pill, so the cue stays hidden.
      const rem = parseFloat(getComputedStyle(doc).fontSize);
      const pill = document.querySelector(".view-switch")?.getBoundingClientRect().top ?? innerHeight - 4.5 * rem;
      cue.hidden = root.offsetTop + top + 2.25 * rem > pill - 0.25 * rem;
    };
    offset();
    addEventListener("resize", offset);
    const progress = () => {
      const length = root.offsetHeight - innerHeight;
      return Math.min(Math.max(-root.getBoundingClientRect().top / length, 0), 1);
    };
    /** Collapses the intro to a plain header. Only when neither camera can show, so there's nothing to scroll through. */
    const giveUp = () => {
      stop?.();
      cancelAnimationFrame(raf);
      removeEventListener("resize", offset);
      // Keep whatever was on screen in place as the pinned stage collapses, anchored on the desk.
      const before = desk?.getBoundingClientRect().top ?? 0;
      delete doc.dataset.intro;
      delete doc.dataset.landed;
      const shift = (desk?.getBoundingClientRect().top ?? 0) - before;
      if (desk && before < innerHeight && shift) scrollBy({ top: shift, behavior: "instant" });
    };
    const stillBroken = () => poster.complete && !poster.naturalWidth;
    // Whether the live camera is out (unsupported, failed to load, or lost its GPU context).
    let liveFailed = !("live3d" in doc.dataset);
    /** The live camera failed: the still takes over where the sequence is. */
    const toStill = () => {
      liveFailed = true;
      stop?.();
      stop = undefined;
      delete stage.dataset.live;
      if (stillBroken()) giveUp();
    };
    poster.addEventListener("error", () => liveFailed && giveUp());
    if (liveFailed && stillBroken()) return giveUp();

    // Scroll drives the page from the first frame, whether or not the 3D camera has loaded.
    let p = progress();
    let shown = -1;
    let last = performance.now();
    const tick = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      // Ease toward the scroll position so scrubbing feels smooth without taking over the page's scrolling.
      const target = progress();
      p += (target - p) * (1 - Math.exp(-dt * 10));
      if (Math.abs(target - p) < 0.0005) p = target;
      if (p !== shown) {
        shown = p;
        stage.style.setProperty("--p", p.toFixed(4));
        stage.style.setProperty("--approach", easeInOut(span(p, TIMELINE.approach)).toFixed(4));
        stage.style.setProperty("--zoom", easeInOut(span(p, TIMELINE.zoom)).toFixed(4));
        stage.style.setProperty("--camera", (1 - span(p, TIMELINE.fadeCamera)).toFixed(4));
        flash.style.opacity = String(0.92 * Math.min(flashAt(p) * 1.4, 1));
        desk?.style.setProperty("--develop", span(p, [0.879, 1]).toFixed(3));
        if (p >= 0.985) doc.dataset.landed = "";
        else delete doc.dataset.landed;
      }
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);

    root.querySelector("[data-skip]")!.addEventListener("click", () => {
      scrollTo({ top: root.offsetTop + root.offsetHeight - innerHeight, behavior: "smooth" });
    });
    let left = false;
    document.addEventListener(
      "astro:before-swap",
      () => {
        left = true;
        stop?.();
        cancelAnimationFrame(raf);
        removeEventListener("resize", offset);
        delete doc.dataset.intro;
        delete doc.dataset.landed;
      },
      { once: true },
    );

    if (!("live3d" in doc.dataset)) return;
    try {
      const model = loadModel(root.dataset.model!);
      const { mountPolaroid600 } = await loadEngine();
      if (left || doc.dataset.intro !== "play") return;
      stop = mountPolaroid600(root.querySelector("canvas")!, model, {
        progress: () => p,
        landing,
        desk: () => document.querySelector<HTMLElement>('[data-desk][data-layout="desk"] [data-desk-top]'),
        onReady: () => (stage.dataset.live = ""),
        onError: toStill,
      });
    } catch {
      toStill();
    }
  });
</script>
