{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "austinrowland-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs first so it can negotiate Markdown and add agent headers to every response.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // Launch switch: austinrowland.com serves a "coming soon" page until this is "true".
  "vars": { "SITE_LIVE": "false" },
  // Production lives only on the custom domains; staging (below) owns the workers.dev site.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "austinrowland.com", "custom_domain": true },
    { "pattern": "www.austinrowland.com", "custom_domain": true }
  ],
  // Previews (one per branch/PR) need no separate settings: the site has no bindings besides ASSETS.
  "previews": {},
  "env": {
    // Workers Builds deploys the staging branch (moved by the deploy-stage action) here, as
    // austinrowland-com-staging on workers.dev; deploy-prod promotes main to production.
    // Routes and vars aren't inherited from the top level.
    "staging": {
      "workers_dev": true,
      "routes": [],
      "vars": { "SITE_LIVE": "false" }
    }
  }
}
